# copy to .env next to docker-compose.yml
DSH_VERSION=0.1.5-rc.3          # npm version of @deepseek-ai/dsh (== git tag dsh-v<version>)
DSH_TRUSTED_HOSTS=              # public hostname(s), space-separated; bootstrap.sh fills it (127.0.0.1 localhost without --domain)
DSH_DATA_DIR=                   # persisted: data/ (=$DSH_HOME) and workspace/; default /root/dsh-data
DSH_GIT_DIR=/srv/git            # bare repos served read-only at /git/
DSH_MEM_LIMIT=2g
TZ=                             # IANA zone; bootstrap.sh takes the host's
DSH_IMAGE_GATEWAY_TOKEN=   # optional (profile imggw): bearer of a host-local image gateway
DSH_IMAGE_GATEWAY_HOST_PORT=8792
DEEPSEEK_API_KEY=            # model key; the launch environment beats every stored layer
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=          # deploy/telegram.sh token
TELEGRAM_CHAT_ID=            # deploy/telegram.sh discover / use

# Compose layering. bootstrap.sh sets COMPOSE_PROFILES=proxy when given --domain.
# Profiles: proxy (bundled Caddy), git (read-only git mirror), imggw (image gateway bridge).
#COMPOSE_PROFILES=
# A machine with its own reverse proxy or network adds an override file:
#COMPOSE_FILE=docker-compose.yml:docker-compose.<machine>.yml
