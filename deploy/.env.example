# copy to .env next to docker-compose.yml
DSH_VERSION=0.1.5-rc.3          # npm version of @deepseek-ai/dsh (== git tag dsh-v<version>)
DSH_TRUSTED_HOSTS=ds.jusl.me    # public hostname(s), space-separated
DSH_DATA_DIR=/root/dsh-data     # persisted: data/ (=$DSH_HOME) and workspace/
DSH_GIT_DIR=/srv/git            # bare repos served read-only at /git/
DSH_MEM_LIMIT=2g
TZ=Europe/Moscow
DSH_IMAGE_GATEWAY_TOKEN=   # bearer of the host image gateway (/etc/smmprop-llm-gateway/token)
DSH_IMAGE_GATEWAY_HOST_PORT=8792
DEEPSEEK_API_KEY=            # model key; the launch environment beats every stored layer
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=          # deploy/telegram.sh token
TELEGRAM_CHAT_ID=            # deploy/telegram.sh discover / use
