# DeepSeek Harness (dsh) — build from THIS checkout (your modifications).
# Needs ~4 GB RAM for `tsc` (build:lib:host runs node with 4 GB heap); build it
# in CI (see .github/workflows/dsh-image.yml) or on a box with enough memory,
# not on a small production host.
FROM node:22-bookworm AS build
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
WORKDIR /src
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm run build
# `pnpm deploy` materialises the CLI package with its production dependency
# closure into one directory that no longer needs the workspace.
RUN pnpm --filter @deepseek-ai/dsh deploy --prod /out/dsh

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates curl ripgrep procps tini openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g --no-audit --no-fund pnpm@11.7.0
COPY --from=build /out/dsh /opt/dsh/app
RUN ln -s /opt/dsh/app/lib/bin.js /usr/local/bin/dsh
COPY deploy/web-docker.patch.yml /opt/dsh/web-docker.patch.yml
COPY deploy/entrypoint.sh /opt/dsh/entrypoint.sh
RUN chmod +x /opt/dsh/entrypoint.sh && mkdir -p /data /workspace && chown node:node /data /workspace
ENV DSH_HOME=/data/dsh HOME=/data DSH_TELEMETRY_MODE=DISABLED NODE_ENV=production
USER node
WORKDIR /workspace
EXPOSE 3080
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/dsh/entrypoint.sh"]
